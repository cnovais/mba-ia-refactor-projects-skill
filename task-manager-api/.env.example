# Copy to .env and fill in. Values here are read by config/settings.py only.

# REQUIRED — signs authentication tokens. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional (defaults shown in comments)
# DATABASE_URL=sqlite:///tasks.db
# TOKEN_MAX_AGE_SECONDS=28800
# Comma-separated list of origins allowed by CORS; empty = no cross-origin access.
CORS_ORIGINS=
# FLASK_DEBUG=false
# HOST=127.0.0.1
# PORT=5000

# E-mail notifications (disabled unless host, user and password are all set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
