# Copie para .env (ou exporte no shell) e ajuste os valores.
# Nenhum destes precisa estar definido para rodar localmente — na ausência,
# config/settings.py usa defaults seguros (SECRET_KEY aleatória por
# execução, DEBUG=false, endpoints admin desabilitados).

# Chave de sessão do Flask. Obrigatória em produção.
SECRET_KEY=

# development | production
FLASK_ENV=development

# true/false — nunca "true" em produção
FLASK_DEBUG=false

HOST=0.0.0.0
PORT=5000

# Caminho do arquivo SQLite
DATABASE_PATH=loja.db

# Token exigido no header X-Admin-Token para acessar /admin/reset-db.
# Sem essa variável definida, o endpoint fica desabilitado (retorna 403).
ADMIN_TOKEN=
