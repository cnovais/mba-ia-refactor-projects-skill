@baseUrl = http://localhost:3000
# Mesmo valor de ADMIN_TOKEN no .env
@adminToken = cole-aqui-o-ADMIN_TOKEN

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Checkout - conta existente com senha errada (401)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Leonan",
  "eml": "leonan@fullcycle.com.br",
  "pwd": "senha-errada",
  "c_id": 2,
  "card": "4111222233334444"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
x-admin-token: {{adminToken}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
x-admin-token: {{adminToken}}
