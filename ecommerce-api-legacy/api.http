@baseUrl = http://localhost:3000
@adminApiKey = set-me-to-match-ADMIN_API_KEY-in-.env

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo
# Requer ADMIN_API_KEY definida no .env do servidor (fail-closed por padrão:
# sem ela configurada, a rota responde 403 mesmo com o header abaixo).
GET {{baseUrl}}/api/admin/financial-report
x-admin-api-key: {{adminApiKey}}

### Deletar usuário
# Idem: requer ADMIN_API_KEY definida no .env do servidor.
DELETE {{baseUrl}}/api/users/1
x-admin-api-key: {{adminApiKey}}
