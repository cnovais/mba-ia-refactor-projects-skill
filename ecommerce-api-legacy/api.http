@baseUrl = http://localhost:3000
@adminToken = coloque_aqui_o_valor_de_ADMIN_TOKEN

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (requer x-admin-token)
GET {{baseUrl}}/api/admin/financial-report
x-admin-token: {{adminToken}}

### Deletar usuário (requer x-admin-token)
DELETE {{baseUrl}}/api/users/1
x-admin-token: {{adminToken}}
