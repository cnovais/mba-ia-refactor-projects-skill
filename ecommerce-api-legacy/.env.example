# Copie para .env e preencha. `npm start` carrega o .env automaticamente.

# Porta HTTP (padrão: 3000)
PORT=3000

# Caminho do banco SQLite (padrão: :memory:)
DB_PATH=:memory:

# OBRIGATÓRIA — chave do gateway de pagamento. Sem ela a aplicação não sobe.
PAYMENT_GATEWAY_KEY=

# Token das rotas administrativas (header x-admin-token).
# Vazio = rotas administrativas bloqueadas (403).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
