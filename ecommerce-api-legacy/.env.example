# Copy to .env and fill in real values for production. Never commit .env.
PORT=3000
DB_PATH=:memory:
DB_USER=
DB_PASS=
PAYMENT_GATEWAY_KEY=
SMTP_USER=
# Required to enable /api/admin/* and DELETE /api/users/:id. Without it,
# those routes fail closed (403 — disabled), they do not open unprotected.
# When set, requests must send this value in the x-admin-api-key header.
ADMIN_API_KEY=
